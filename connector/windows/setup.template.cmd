@echo off
rem Bikas WhatsApp: one-click installer for Windows 10/11 (generated by the CRM; contains a secret key: do not send it to anyone).
rem This batch part is plain ASCII: it only starts PowerShell, which runs the script stored below the #PAYLOAD line.
rem The PowerShell script is UTF-8 (Russian texts). cmd never reads past "exit /b".
setlocal
title Bikas WhatsApp
set "BK_SELF=%~f0"
powershell -NoProfile -ExecutionPolicy Bypass -Command "& { $t = [IO.File]::ReadAllText($env:BK_SELF, [Text.Encoding]::UTF8); $p = [regex]::Split($t, '(?m)^#PAYLOAD\s*$')[1]; & ([scriptblock]::Create($p)) }"
set "BK_RC=%ERRORLEVEL%"
echo.
pause
exit /b %BK_RC%
#PAYLOAD
$ErrorActionPreference = 'Stop'
$ProgressPreference = 'SilentlyContinue'
try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }
try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch { }

# Filled in by the CRM when the file is downloaded.
$CrmUrl = '__CRM_URL__'
$Token = '__CONNECTOR_TOKEN__'

$NodeVersion = '20.20.2'
$Repo = 'sildar010386-cloud/ai-commerce-os'
$Branch = 'claude/practical-mendel-vjtsd5'
$TaskName = 'BikasWhatsApp'
$Root = Join-Path $env:LOCALAPPDATA 'BikasWhatsApp'
$NodeDir = Join-Path $Root 'node'
$NodeExe = Join-Path $NodeDir 'node.exe'
$Launcher = Join-Path $Root 'launcher.vbs'
$StartupVbs = Join-Path ([Environment]::GetFolderPath('Startup')) 'BikasWhatsApp.vbs'
$Utf8Bom = New-Object System.Text.UTF8Encoding($true)
$Utf8NoBom = New-Object System.Text.UTF8Encoding($false)

function Say([string]$text, [string]$color = 'Gray') { Write-Host $text -ForegroundColor $color }
function Step([string]$text) { Write-Host ''; Write-Host $text -ForegroundColor Cyan }

function Get-BikasProcs {
  # Killing a parent does not kill its child on Windows, so a connector can outlive its supervisor: every node.exe that RUNS FROM the
  # install folder (ExecutablePath) counts, whatever its command line, plus the wscript launcher (found by its command line).
  $rootSlash = $Root.TrimEnd('\') + '\'
  return @(Get-CimInstance Win32_Process | Where-Object {
    ($_.Name -eq 'node.exe' -and (($_.ExecutablePath -and $_.ExecutablePath.StartsWith($rootSlash, [StringComparison]::OrdinalIgnoreCase)) -or ($_.CommandLine -and $_.CommandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0))) -or
    ($_.Name -eq 'wscript.exe' -and $_.CommandLine -and $_.CommandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0)
  })
}
function Stop-Bikas {
  try { Stop-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue } catch { }
  for ($i = 0; $i -lt 5; $i++) {
    $procs = @(Get-BikasProcs)
    if ($procs.Count -eq 0) { break }
    # the launcher first, so that it cannot start a new supervisor; the whole process tree of each one goes with it
    foreach ($p in @($procs | Sort-Object { if ($_.Name -eq 'wscript.exe') { 0 } else { 1 } })) {
      try { & taskkill.exe /PID $p.ProcessId /T /F 2>&1 | Out-Null } catch { }
    }
    Start-Sleep -Milliseconds 700
  }
}

function Test-Running {
  $procs = @(Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -and $_.CommandLine.IndexOf('supervisor.js', [StringComparison]::OrdinalIgnoreCase) -ge 0 -and $_.CommandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0 })
  return ($procs.Count -gt 0)
}

function Test-Crm {
  try {
    $r = Invoke-WebRequest -UseBasicParsing -Uri ($CrmUrl.TrimEnd('/') + '/api/connector/outbox?ready=0') -Headers @{ Authorization = "Bearer $Token" } -TimeoutSec 25
    return ($r.StatusCode -eq 200)
  } catch {
    $code = 0
    try { $code = [int]$_.Exception.Response.StatusCode } catch { }
    if ($code -eq 401) { throw 'Ключ подключения устарел или неверный. Откройте CRM, снова нажмите «Скачать установщик для Windows» и запустите новый файл.' }
    throw ('Не удалось связаться с CRM (' + $CrmUrl + '). Проверьте интернет и запустите файл ещё раз.')
  }
}

function Install-Node {
  if (Test-Path -LiteralPath $NodeExe) {
    $v = ''
    try { $v = (& $NodeExe --version 2>$null) } catch { }
    if ($v -eq ('v' + $NodeVersion)) { Say 'Node.js уже установлен.'; return }
  }
  $tmp = Join-Path $Root 'tmp'
  if (Test-Path -LiteralPath $tmp) { Remove-Item -LiteralPath $tmp -Recurse -Force }
  New-Item -ItemType Directory -Path $tmp -Force | Out-Null
  $zipName = 'node-v' + $NodeVersion + '-win-x64.zip'
  $base = 'https://nodejs.org/dist/v' + $NodeVersion + '/'
  $sums = (Invoke-WebRequest -UseBasicParsing -Uri ($base + 'SHASUMS256.txt')).Content
  if ($sums -is [byte[]]) { $sums = [Text.Encoding]::ASCII.GetString($sums) }
  $line = @($sums -split "`n" | Where-Object { $_ -match ([regex]::Escape($zipName) + '\s*$') })[0]
  $expected = ''
  if ($line) { $expected = ($line.Trim() -split '\s+')[0].ToLower() }
  if ($expected.Length -ne 64) { throw 'Не получилось проверить Node.js (нет контрольной суммы).' }
  $zip = Join-Path $tmp $zipName
  Say 'Скачиваю Node.js (около 30 МБ)...'
  Invoke-WebRequest -UseBasicParsing -Uri ($base + $zipName) -OutFile $zip
  $actual = (Get-FileHash -Algorithm SHA256 -LiteralPath $zip).Hash.ToLower()
  if ($actual -ne $expected) { throw 'Контрольная сумма Node.js не совпала: файл повреждён при скачивании. Запустите установщик ещё раз.' }
  Say 'Распаковываю...'
  Add-Type -AssemblyName System.IO.Compression.FileSystem
  $out = Join-Path $tmp 'x'
  [IO.Compression.ZipFile]::ExtractToDirectory($zip, $out)
  if (Test-Path -LiteralPath $NodeDir) { Remove-Item -LiteralPath $NodeDir -Recurse -Force }
  Move-Item -LiteralPath (Join-Path $out ('node-v' + $NodeVersion + '-win-x64')) -Destination $NodeDir
  Remove-Item -LiteralPath $tmp -Recurse -Force
  $v = (& $NodeExe --version 2>$null)
  if ($v -ne ('v' + $NodeVersion)) { throw 'Node.js не запускается на этом компьютере.' }
}

function Install-Code {
  $boot = Join-Path $Root 'bootstrap'
  New-Item -ItemType Directory -Path $boot -Force | Out-Null
  $bootFile = Join-Path $boot 'update.mjs'
  $url = 'https://raw.githubusercontent.com/' + $Repo + '/' + $Branch + '/connector/src/update.js'
  Invoke-WebRequest -UseBasicParsing -Uri $url -OutFile $bootFile
  $env:PATH = $NodeDir + ';' + $env:PATH
  & $NodeExe $bootFile install $Root --force
  if ($LASTEXITCODE -ne 0) { throw 'Не получилось скачать и установить программу подключения. Проверьте интернет и запустите файл ещё раз.' }
  if (-not (Test-Path -LiteralPath (Join-Path $Root 'app\src\supervisor.js'))) { throw 'Программа подключения установлена не полностью.' }
}

function Write-Config {
  $cfg = Join-Path $Root 'config.env'
  $text = "CRM_URL=" + $CrmUrl + "`r`nCONNECTOR_TOKEN=" + $Token + "`r`nBIKAS_AUTOUPDATE=1`r`n"
  [IO.File]::WriteAllText($cfg, $text, $Utf8NoBom)
  # readable only by this Windows user
  $sid = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
  & icacls.exe $cfg /inheritance:r /grant:r ('*' + $sid + ':(F)') | Out-Null
  if ($LASTEXITCODE -ne 0) { Say 'Не удалось ограничить доступ к файлу config.env (это не мешает работе).' 'Yellow' }
}

$ToolsPs1 = @'
param([string]$Action)
$ErrorActionPreference = 'Continue'
try { [Console]::OutputEncoding = [Text.Encoding]::UTF8 } catch { }
$Root = Join-Path $env:LOCALAPPDATA 'BikasWhatsApp'
$TaskName = 'BikasWhatsApp'
$Launcher = Join-Path $Root 'launcher.vbs'
$StartupVbs = Join-Path ([Environment]::GetFolderPath('Startup')) 'BikasWhatsApp.vbs'

function Get-BikasProcs {
  # Killing a parent does not kill its child on Windows, so a connector can outlive its supervisor: every node.exe that RUNS FROM the
  # install folder (ExecutablePath) counts, whatever its command line, plus the wscript launcher (found by its command line).
  $rootSlash = $Root.TrimEnd('\') + '\'
  return @(Get-CimInstance Win32_Process | Where-Object {
    ($_.Name -eq 'node.exe' -and (($_.ExecutablePath -and $_.ExecutablePath.StartsWith($rootSlash, [StringComparison]::OrdinalIgnoreCase)) -or ($_.CommandLine -and $_.CommandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0))) -or
    ($_.Name -eq 'wscript.exe' -and $_.CommandLine -and $_.CommandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0)
  })
}
function Stop-Bikas {
  try { Stop-ScheduledTask -TaskName $TaskName -ErrorAction SilentlyContinue } catch { }
  for ($i = 0; $i -lt 5; $i++) {
    $procs = @(Get-BikasProcs)
    if ($procs.Count -eq 0) { break }
    # the launcher first, so that it cannot start a new supervisor; the whole process tree of each one goes with it
    foreach ($p in @($procs | Sort-Object { if ($_.Name -eq 'wscript.exe') { 0 } else { 1 } })) {
      try { & taskkill.exe /PID $p.ProcessId /T /F 2>&1 | Out-Null } catch { }
    }
    Start-Sleep -Milliseconds 700
  }
}
function Test-Running {
  $procs = @(Get-CimInstance Win32_Process | Where-Object { $_.Name -eq 'node.exe' -and $_.CommandLine -and $_.CommandLine.IndexOf('supervisor.js', [StringComparison]::OrdinalIgnoreCase) -ge 0 -and $_.CommandLine.IndexOf($Root, [StringComparison]::OrdinalIgnoreCase) -ge 0 })
  return ($procs.Count -gt 0)
}
function Start-Bikas {
  if (Test-Running) { return }
  $started = $false
  try { if (Get-ScheduledTask -TaskName $TaskName -ErrorAction Stop) { Start-ScheduledTask -TaskName $TaskName -ErrorAction Stop; $started = $true } } catch { }
  if ($started) { Start-Sleep -Seconds 4 }
  if (-not (Test-Running)) {
    Start-Process -FilePath 'wscript.exe' -ArgumentList @('//B', '//Nologo', ('"' + $Launcher + '"')) -WindowStyle Hidden
    Start-Sleep -Seconds 4
  }
}

if ($Action -eq 'stop') {
  Stop-Bikas
  if (Test-Running) { Write-Host 'Не получилось остановить. Перезагрузите компьютер.' -ForegroundColor Red }
  else { Write-Host 'Остановлено. Сообщения из WhatsApp не поступают в CRM, пока подключение выключено.' -ForegroundColor Green; Write-Host 'Чтобы включить снова, откройте «Запустить.cmd» (или перезайдите в Windows).' }
}
elseif ($Action -eq 'start') {
  if (-not (Test-Path -LiteralPath (Join-Path $Root 'app\src\supervisor.js'))) { Write-Host 'Подключение не установлено. Скачайте установщик в CRM и запустите его.' -ForegroundColor Red }
  else {
    Start-Bikas
    if (Test-Running) { Write-Host 'Запущено. Окно можно закрыть: подключение работает в фоне.' -ForegroundColor Green }
    else { Write-Host 'Не удалось запустить. Посмотрите файл connector.log в папке программы.' -ForegroundColor Red }
  }
}
elseif ($Action -eq 'uninstall') {
  Write-Host 'Будет удалено подключение WhatsApp к CRM с этого компьютера: программа, автозапуск и сохранённый вход в WhatsApp.' -ForegroundColor Yellow
  Write-Host 'Сообщения и чаты в CRM остаются. Подключить заново можно, скачав установщик в CRM.'
  $a = Read-Host 'Чтобы удалить, введите слово ДА и нажмите Enter (любой другой ответ отменит удаление)'
  if (@('ДА', 'DA', 'YES', 'Y') -notcontains $a.Trim().ToUpper()) { Write-Host 'Отменено. Ничего не удалено.' }
  else {
    Stop-Bikas
    try { Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue } catch { }
    try { Remove-Item -LiteralPath $StartupVbs -Force -ErrorAction SilentlyContinue } catch { }
    Set-Location -LiteralPath $env:TEMP
    for ($i = 0; $i -lt 4; $i++) {
      try { if (Test-Path -LiteralPath $Root) { Remove-Item -LiteralPath $Root -Recurse -Force -ErrorAction Stop } } catch { Start-Sleep -Seconds 2 }
    }
    if (Test-Path -LiteralPath $Root) { Write-Host 'Часть файлов не удалилась (занята другой программой). Перезагрузите компьютер и удалите папку вручную:' -ForegroundColor Red; Write-Host $Root }
    else { Write-Host 'Удалено.' -ForegroundColor Green }
    Write-Host 'Осталось один раз на телефоне: WhatsApp → Связанные устройства → выберите это устройство → Выйти.'
  }
}
'@

function Write-Support {
  $vbs = 'Set sh = CreateObject("WScript.Shell")' + "`r`n" +
    'root = "' + $Root + '"' + "`r`n" +
    'sh.CurrentDirectory = root' + "`r`n" +
    'sh.Environment("Process")("BIKAS_HOME") = root' + "`r`n" +
    'Do' + "`r`n" +
    '  rc = sh.Run("""" & root & "\node\node.exe"" """ & root & "\app\src\supervisor.js""", 0, True)' + "`r`n" +
    '  If rc = 99 Then Exit Do' + "`r`n" +
    '  WScript.Sleep 10000' + "`r`n" +
    'Loop' + "`r`n"
  [IO.File]::WriteAllText($Launcher, $vbs, [Text.Encoding]::Unicode)
  [IO.File]::WriteAllText((Join-Path $Root 'tools.ps1'), ($ToolsPs1 -replace "`r?`n", "`r`n"), $Utf8Bom)
  $names = @{ 'stop' = 'Остановить.cmd'; 'start' = 'Запустить.cmd'; 'uninstall' = 'Удалить.cmd' }
  foreach ($k in $names.Keys) {
    $cmd = '@echo off' + "`r`n" +
      'copy /y "%~dp0tools.ps1" "%TEMP%\bikas-tools.ps1" >nul' + "`r`n" +
      'powershell -NoProfile -ExecutionPolicy Bypass -File "%TEMP%\bikas-tools.ps1" ' + $k + "`r`n" +
      'pause' + "`r`n"
    [IO.File]::WriteAllText((Join-Path $Root $names[$k]), $cmd, [Text.Encoding]::ASCII)
  }
}

function Register-Autostart {
  $user = [Security.Principal.WindowsIdentity]::GetCurrent().Name
  try {
    $action = New-ScheduledTaskAction -Execute 'wscript.exe' -Argument ('//B //Nologo "' + $Launcher + '"')
    $trigger = New-ScheduledTaskTrigger -AtLogOn -User $user
    $settings = New-ScheduledTaskSettingsSet -AllowStartIfOnBatteries -DontStopIfGoingOnBatteries -StartWhenAvailable -RestartCount 999 -RestartInterval (New-TimeSpan -Minutes 1) -ExecutionTimeLimit ([TimeSpan]::Zero) -MultipleInstances IgnoreNew
    $principal = New-ScheduledTaskPrincipal -UserId $user -LogonType Interactive -RunLevel Limited
    Register-ScheduledTask -TaskName $TaskName -Action $action -Trigger $trigger -Settings $settings -Principal $principal -Force -ErrorAction Stop | Out-Null
    if (Get-ScheduledTask -TaskName $TaskName -ErrorAction Stop) {
      try { Remove-Item -LiteralPath $StartupVbs -Force -ErrorAction SilentlyContinue } catch { }
      return 'task'
    }
  } catch { }
  # No rights for a scheduled task: a small hidden script in the Startup folder does the same at logon.
  try { Unregister-ScheduledTask -TaskName $TaskName -Confirm:$false -ErrorAction SilentlyContinue } catch { }
  $stub = 'CreateObject("WScript.Shell").Run "wscript.exe //B //Nologo ""' + $Launcher + '""", 0, False' + "`r`n"
  [IO.File]::WriteAllText($StartupVbs, $stub, [Text.Encoding]::Unicode)
  return 'startup'
}

try {
  Write-Host ''
  Write-Host 'Установка подключения WhatsApp для CRM Bikas' -ForegroundColor White
  Write-Host 'Папка установки: ' $Root
  if (-not [Environment]::Is64BitOperatingSystem) { throw 'Нужна 64-разрядная Windows 10 или 11.' }
  if ($PSVersionTable.PSVersion.Major -lt 5) { throw 'Нужна Windows 10 или 11 (устаревший PowerShell).' }
  if (-not $env:LOCALAPPDATA) { throw 'Не найдена папка пользователя Windows.' }

  Step '[1/6] Проверяю связь с CRM...'
  Test-Crm | Out-Null
  Say 'Связь есть, ключ подключения принят.' 'Green'

  Step '[2/6] Останавливаю старую копию (если она была)...'
  New-Item -ItemType Directory -Path $Root -Force | Out-Null
  Stop-Bikas

  Step '[3/6] Устанавливаю Node.js (нужен только этой программе)...'
  Install-Node

  Step '[4/6] Скачиваю и устанавливаю программу подключения (1-3 минуты)...'
  Install-Code

  Step '[5/6] Сохраняю настройки и создаю автозапуск...'
  New-Item -ItemType Directory -Path (Join-Path $Root 'data') -Force | Out-Null   # the WhatsApp session lives here and is never deleted
  Write-Config
  Write-Support
  $mode = Register-Autostart
  if ($mode -eq 'task') { Say 'Автозапуск при входе в Windows настроен.' 'Green' }
  else { Say 'Автозапуск настроен через папку «Автозагрузка».' 'Green' }

  Step '[6/6] Запускаю подключение...'
  $tries = 0
  $ok = $false
  while ($tries -lt 3 -and -not $ok) {
    $tries++
    if ($mode -eq 'task' -and $tries -eq 1) { try { Start-ScheduledTask -TaskName $TaskName -ErrorAction Stop } catch { } }
    else { Start-Process -FilePath 'wscript.exe' -ArgumentList @('//B', '//Nologo', ('"' + $Launcher + '"')) -WindowStyle Hidden }
    Start-Sleep -Seconds 5
    $ok = Test-Running
  }
  if (-not $ok) { throw 'Подключение не запустилось. Посмотрите файл connector.log в папке установки.' }

  Write-Host ''
  Write-Host 'Готово. Откройте CRM → Настройки → Подключение WhatsApp и отсканируйте QR-код' -ForegroundColor Green
  Write-Host ''
  Write-Host 'Важно: пока ноутбук включён и есть интернет, сообщения приходят в CRM. Когда он выключен, WhatsApp хранит их и отдаёт при следующем включении.'
  Write-Host ('В папке ' + $Root + ' есть файлы «Остановить.cmd», «Запустить.cmd» и «Удалить.cmd».')
  exit 0
} catch {
  Write-Host ''
  Write-Host ('Не получилось: ' + $_.Exception.Message) -ForegroundColor Red
  Write-Host 'Запустите файл ещё раз. Если снова ошибка, сфотографируйте это окно и отправьте разработчику.'
  exit 1
}
